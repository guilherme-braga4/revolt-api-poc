# Ambiente dos testes do Postman/Newman. Versionado: não tem chave real.
# OCM e Google apontam para os dublês do teste/apoio.mjs, nunca para os serviços reais.
PORT=3334
# A API fala com o banco pelo proxy do teste/apoio.mjs (porta 4011), que simula quedas de conexão; o apoio fala direto.
DATABASE_URL=postgres://revolt:revolt_local@localhost:4011/revolt_teste
BANCO_DIRETO_URL=postgres://revolt:revolt_local@localhost:5433/revolt_teste
OCM_URL=http://localhost:4010/ocm/v3
OCM_API_KEY=chave-falsa-de-teste
GOOGLE_PLACES_URL=http://localhost:4010/google/v1
GOOGLE_PLACES_API_KEY=chave-falsa-de-teste
GOOGLE_ROUTES_URL=http://localhost:4010/google-rotas
# Prazo de cada consulta ao Google. O teste do Google lento (seção 11) depende dele.
GOOGLE_TEMPO_LIMITE_MS=2000
OCM_TEMPO_LIMITE_MS=2000
APOIO_PORT=4010

# Varredura do Google só numa célula em volta de São José dos Campos (o padrão é o Brasil inteiro).
REGIAO_VARREDURA=teste/regiao-teste.geojson

# Login gerenciado e atestado do app: dublês do teste/apoio.mjs, com chaves geradas ao subir (nenhum segredo aqui).
CONTA_JWKS_URL=http://localhost:4010/__apoio/jwks
CONTA_EMISSOR=https://login.teste/revolt
CONTA_PUBLICO=revolt-teste
CURADOR_CONTAS=curador-teste
ATESTADO_JWKS_URL=http://localhost:4010/__apoio/jwks
ATESTADO_EMISSOR=https://atestado.teste/revolt
ATESTADO_PUBLICO=projects/revolt-teste
# Prazo de cada etapa de acesso ao banco, o mesmo da produção. Os limites de tempo da seção 10 da coleção dependem dele.
# Com 3 s, abrir uma conexão nova passou do prazo com a máquina muito carregada (carga média acima de 100).
BANCO_TEMPO_LIMITE_MS=5000
# Trava contra ritmo de robô: fichas do Google por aparelho a cada 10 minutos.
LIMITE_FICHAS_GOOGLE=20
# Trava contra ritmo de robô: viagens planejadas por aparelho a cada 10 minutos (cada uma pede rota e busca ao Google).
LIMITE_ROTAS_GOOGLE=5
# Trava de ritmo da telemetria: envios por IP a cada 10 minutos. O último teste da seção 13 passa do limite.
LIMITE_EVENTOS=20
