# Ambiente dos testes do Postman/Newman. Versionado: não tem chave real.
# OCM e Google apontam para os dublês do teste/apoio.mjs, nunca para os serviços reais.
PORT=3334
DATABASE_URL=postgres://revolt:revolt_local@localhost:5433/revolt_teste
OCM_URL=http://localhost:4010/ocm/v3
OCM_API_KEY=chave-falsa-de-teste
GOOGLE_PLACES_URL=http://localhost:4010/google/v1
GOOGLE_PLACES_API_KEY=chave-falsa-de-teste
APOIO_PORT=4010

# Varredura do Google só numa célula em volta de São José dos Campos (o padrão é o Brasil inteiro).
REGIAO_VARREDURA=teste/regiao-teste.geojson

# Login gerenciado e atestado do app: dublês do teste/apoio.mjs, com chaves geradas ao subir (nenhum segredo aqui).
CONTA_JWKS_URL=http://localhost:4010/__apoio/jwks
CONTA_EMISSOR=https://login.teste/revolt
CONTA_PUBLICO=revolt-teste
ATESTADO_JWKS_URL=http://localhost:4010/__apoio/jwks
ATESTADO_EMISSOR=https://atestado.teste/revolt
ATESTADO_PUBLICO=projects/revolt-teste
# Trava contra ritmo de robô: fichas do Google por aparelho a cada 10 minutos.
LIMITE_FICHAS_GOOGLE=20
