# Copie para .env e preencha as chaves. O .env não é versionado.
PORT=3333

# Banco local do docker-compose (credenciais só de teste)
DATABASE_URL=postgres://revolt:revolt_local@localhost:5433/revolt

# Open Charge Map, acesso ao vivo
OCM_URL=https://api.openchargemap.io/v3
OCM_API_KEY=

# Prazo, em ms, da busca no OCM (com o corpo inteiro). Passado o prazo, a atualização falha e a cópia anterior continua.
# Padrão: 60000.
# OCM_TEMPO_LIMITE_MS=60000

# Google Places API (New). A chave tem faturamento ativo: cada chamada é cobrada.
GOOGLE_PLACES_URL=https://places.googleapis.com/v1
# A mesma chave serve à busca e à rota do Google: precisa liberar o Places API (New) e o Routes API (D-07).
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com
# Prazo, em ms, de cada consulta ao Google. Passado o prazo, conta como Google fora do ar. Padrão: 10000.
# GOOGLE_TEMPO_LIMITE_MS=10000

# Só para npm run postman:sync (sincronizar a coleção com a sua conta Postman)
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=

# Login gerenciado (D-04), ex.: Firebase Authentication. Vazio: nenhuma rota com conta funciona.
CONTA_JWKS_URL=
CONTA_EMISSOR=
CONTA_PUBLICO=
# Contas com papel de Curador: identificadores (sub) do provedor de login, separados por vírgula.
CURADOR_CONTAS=

# Atestado do app (D-09), ex.: Firebase App Check. Vazio: atestado desligado, só para desenvolvimento local.
ATESTADO_JWKS_URL=
ATESTADO_EMISSOR=
ATESTADO_PUBLICO=

# Trava contra ritmo de robô: fichas do Google por aparelho a cada 10 minutos (padrão 60).
LIMITE_FICHAS_GOOGLE=60
# Trava contra ritmo de robô: viagens planejadas por aparelho a cada 10 minutos (cada uma pede rota e busca ao Google).
LIMITE_ROTAS_GOOGLE=20

# Prazo, em ms, para conseguir uma conexão com o banco e para cada consulta. Passado o prazo, o pedido falha com 503
# (base_indisponivel) e a conexão ruim sai do pool. Padrão: 5000. Vale só para os pedidos: as tarefas longas (atualização
# do OCM, grade e expiração do Google) têm prazo próprio de 10 minutos.
# BANCO_TEMPO_LIMITE_MS=5000
