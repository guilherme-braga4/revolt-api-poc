# Copie para .env e preencha as chaves. O .env não é versionado.
PORT=3333

# Banco local do docker-compose (credenciais só de teste)
DATABASE_URL=postgres://revolt:revolt_local@localhost:5433/revolt

# Open Charge Map, acesso ao vivo
OCM_URL=https://api.openchargemap.io/v3
OCM_API_KEY=

# Google Places API (New). A chave tem faturamento ativo: cada chamada é cobrada.
GOOGLE_PLACES_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_API_KEY=

# Só para npm run postman:sync (sincronizar a coleção com a sua conta Postman)
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
