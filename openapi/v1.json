{
  "openapi": "3.0.0",
  "paths": {
    "/v1/mapa": {
      "get": {
        "description": "Lê só a base do REVOLT: nenhuma fonte externa é consultada. Abaixo do zoom 13, os postos do OCM e próprios são agrupados por uma grade de 4x4 células por bloco de 256 px; célula com um posto só vira pino. A partir do zoom 13, tudo vem um a um e os lugares de origem google aparecem, desde que nenhum filtro esteja ativo e o pedido traga o atestado do app. A janela pode ter no máximo 8 blocos de lado no zoom pedido.",
        "operationId": "MapaController_mapa",
        "parameters": [
          {
            "name": "bbox",
            "required": true,
            "in": "query",
            "description": "Janela visível do mapa: oeste,sul,leste,norte (longitude e latitude em graus, WGS 84). O que passa dos limites do mundo é recortado.",
            "schema": {
              "example": "-45.93,-23.24,-45.83,-23.14",
              "type": "string"
            }
          },
          {
            "name": "zoom",
            "required": true,
            "in": "query",
            "description": "Zoom do mapa do Google (0 a 22).",
            "schema": {
              "example": 14,
              "type": "integer"
            }
          },
          {
            "name": "conectores",
            "required": false,
            "in": "query",
            "description": "Perfil do carro: tipos de conector aceitos, separados por vírgula. Esconde os postos sem nenhum deles e os de conector desconhecido.",
            "schema": {
              "example": "CCS2,TIPO_2",
              "type": "string"
            }
          },
          {
            "name": "potencia_min",
            "required": false,
            "in": "query",
            "description": "Potência mínima em kW. Esconde os postos abaixo dela e os de potência desconhecida.",
            "schema": {
              "example": 50,
              "type": "number"
            }
          },
          {
            "name": "rapida",
            "required": false,
            "in": "query",
            "description": "Só carga rápida: pelo menos um conector CCS2, CCS1 ou CHADEMO.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "publico",
            "required": false,
            "in": "query",
            "description": "Só acesso público. Esconde os restritos e os de acesso desconhecido.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "gratuito",
            "required": false,
            "in": "query",
            "description": "Só gratuitos, pelo preço informado. Esconde os pagos e os de preço desconhecido.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "X-Atestado-App",
            "in": "header",
            "description": "Token do atestado do app (D-09). Sem ele, a resposta não traz dados do Google.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaMapa"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "summary": "Postos da janela visível do mapa",
        "tags": [
          "mapa"
        ]
      }
    },
    "/v1/eletropostos/{id}": {
      "get": {
        "description": "Postos do OCM e próprios vêm da base, com origem e data de cada atributo. Lugares de origem google: a ficha é buscada no Google na hora, entregue e descartada, e exige o atestado do app. Sem ficha (teto, Google fora do ar, camada desligada ou ritmo de robô), a resposta traz link_externo para abrir o lugar no Google Maps sem consulta paga.",
        "operationId": "FichaController_ficha",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ocm-<n>, propria-<n> ou google-<identificador>",
            "schema": {
              "example": "ocm-9001",
              "type": "string"
            }
          },
          {
            "name": "X-Aparelho",
            "in": "header",
            "description": "Identificador do aparelho, gerado pelo app, para a trava contra ritmo de robô.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Atestado-App",
            "in": "header",
            "description": "Token do atestado do app (D-09). Obrigatório para a ficha de origem google.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ficha"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Ficha de origem google sem atestado do app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Ritmo de robô: muitas fichas do Google pelo mesmo aparelho.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FichaIndisponivel"
                }
              }
            }
          },
          "503": {
            "description": "Ficha do Google indisponível: teto atingido, camada desligada ou Google fora do ar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FichaIndisponivel"
                }
              }
            }
          }
        },
        "summary": "Ficha de um posto",
        "tags": [
          "ficha"
        ]
      }
    },
    "/v1/conta": {
      "get": {
        "description": "Valida o token do provedor de login (D-04). A conta só é exigida para contribuir.",
        "operationId": "ContaController_conta",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conta"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Conta do token",
        "tags": [
          "conta"
        ]
      }
    }
  },
  "info": {
    "title": "REVOLT · API do app do motorista",
    "description": "Contrato /v1, em JSON e no vocabulário do REVOLT. Todo item traz origem, verificacao, atualizado_em e condicoes_de_uso. Datas de item são dias (AAAA-MM-DD, fuso de Brasília). Valores novos podem entrar nas listas fechadas: o app deve tolerá-los.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Janela": {
        "type": "object",
        "properties": {
          "bbox": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "zoom": {
            "type": "integer"
          }
        },
        "required": [
          "bbox",
          "zoom"
        ]
      },
      "Localizacao": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": -23.19
          },
          "lng": {
            "type": "number",
            "example": -45.88
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "Verificacao": {
        "type": "object",
        "properties": {
          "situacao": {
            "type": "string",
            "enum": [
              "verificado",
              "nao_verificado"
            ],
            "description": "Só observação em campo do Curador torna o posto verificado."
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true,
            "description": "Dia da observação em campo vigente. null quando não verificado."
          }
        },
        "required": [
          "situacao",
          "data"
        ]
      },
      "CondicoesDeUso": {
        "type": "object",
        "properties": {
          "licenca": {
            "type": "string",
            "description": "Licença ou termos da fonte.",
            "example": "CC BY 4.0"
          },
          "atribuicao": {
            "type": "string",
            "nullable": true,
            "description": "Crédito que o app mostra com o dado. null quando não há.",
            "example": "Open Charge Map Contributors via Open Charge Map"
          },
          "exibicao": {
            "type": "string",
            "enum": [
              "livre",
              "somente_sobre_mapa_google"
            ],
            "description": "Onde o item pode aparecer. Lugares de origem google só sobre o mapa do Google, com o logo."
          },
          "pode_ler_em_voz": {
            "type": "boolean",
            "description": "false: o item nunca é lido em voz (RN07 do app)."
          },
          "pode_usar_em_ia": {
            "type": "boolean",
            "description": "false: o item nunca entra em recurso de IA (RN07 do app)."
          },
          "texto": {
            "type": "string",
            "description": "As condições por extenso."
          }
        },
        "required": [
          "licenca",
          "atribuicao",
          "exibicao",
          "pode_ler_em_voz",
          "pode_usar_em_ia",
          "texto"
        ]
      },
      "Pino": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ocm-<n>, propria-<n> ou google-<identificador>.",
            "example": "ocm-9001"
          },
          "localizacao": {
            "$ref": "#/components/schemas/Localizacao"
          },
          "nome": {
            "type": "string",
            "nullable": true,
            "description": "null nos lugares de origem google (o nome só vem na ficha)."
          },
          "situacao": {
            "type": "string",
            "enum": [
              "operacional",
              "fora_de_operacao",
              "planejado",
              "fechado_definitivamente",
              "desconhecida"
            ]
          },
          "conectores": {
            "type": "array",
            "nullable": true,
            "description": "Tipos de conector, para marcar a compatibilidade com o carro. null nos lugares de origem google.",
            "items": {
              "type": "string",
              "enum": [
                "CCS2",
                "CCS1",
                "TIPO_2",
                "TIPO_1",
                "CHADEMO",
                "GBT",
                "TESLA",
                "TOMADA",
                "OUTRO",
                "DESCONHECIDO"
              ]
            }
          },
          "potencia_max_kw": {
            "type": "number",
            "nullable": true,
            "description": "Maior potência nominal em kW. null quando desconhecida."
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "description": "De onde vem o item. Define as condições de uso."
          },
          "verificacao": {
            "$ref": "#/components/schemas/Verificacao"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "description": "Dia da informação mais confiável: a verificação em campo, se houver; senão, o dia em que a fonte foi obtida."
          },
          "condicoes_de_uso": {
            "$ref": "#/components/schemas/CondicoesDeUso"
          }
        },
        "required": [
          "id",
          "localizacao",
          "nome",
          "situacao",
          "conectores",
          "potencia_max_kw",
          "origem",
          "verificacao",
          "atualizado_em",
          "condicoes_de_uso"
        ]
      },
      "Grupo": {
        "type": "object",
        "properties": {
          "localizacao": {
            "description": "Centro dos postos do grupo.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Localizacao"
              }
            ]
          },
          "quantidade": {
            "type": "integer",
            "description": "Quantidade de postos do OCM e próprios no grupo. Nunca inclui lugares de origem google.",
            "example": 12
          },
          "bbox": {
            "description": "Extensão dos postos do grupo (oeste,sul,leste,norte), para aproximar ao tocar.",
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "localizacao",
          "quantidade",
          "bbox"
        ]
      },
      "OcultosPorMotivo": {
        "type": "object",
        "properties": {
          "conector": {
            "type": "integer"
          },
          "potencia": {
            "type": "integer"
          },
          "rapida": {
            "type": "integer"
          },
          "publico": {
            "type": "integer"
          },
          "gratuito": {
            "type": "integer"
          }
        },
        "required": [
          "conector",
          "potencia",
          "rapida",
          "publico",
          "gratuito"
        ]
      },
      "OcultosSemContagem": {
        "type": "object",
        "properties": {
          "ha_ocultos": {
            "type": "boolean",
            "description": "Há lugares de origem google na janela que não aparecem. Nunca vem com número (RN08 do app)."
          },
          "motivo": {
            "type": "string",
            "enum": [
              "filtro",
              "zoom"
            ],
            "nullable": true,
            "description": "filtro: algum filtro está ativo; zoom: só aparecem a partir do zoom alto."
          }
        },
        "required": [
          "ha_ocultos",
          "motivo"
        ]
      },
      "Ocultos": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Postos do OCM e próprios da janela escondidos pelos filtros."
          },
          "por_motivo": {
            "description": "Quantos cada filtro esconde. Um posto escondido por dois filtros conta nos dois.",
            "allOf": [
              {
                "$ref": "#/components/schemas/OcultosPorMotivo"
              }
            ]
          },
          "sem_contagem": {
            "$ref": "#/components/schemas/OcultosSemContagem"
          }
        },
        "required": [
          "total",
          "por_motivo",
          "sem_contagem"
        ]
      },
      "SituacaoFonte": {
        "type": "object",
        "properties": {
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ]
          },
          "situacao": {
            "type": "string",
            "enum": [
              "ligada",
              "desligada",
              "nao_autorizada"
            ],
            "description": "nao_autorizada: o pedido não veio do app atestado e não recebe dados do Google."
          }
        },
        "required": [
          "origem",
          "situacao"
        ]
      },
      "RespostaMapa": {
        "type": "object",
        "properties": {
          "janela": {
            "$ref": "#/components/schemas/Janela"
          },
          "pinos": {
            "description": "Postos um a um. Lugares de origem google só a partir do zoom alto e sem nenhum filtro ativo.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pino"
            }
          },
          "grupos": {
            "description": "Agrupamentos por grade abaixo do zoom alto.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grupo"
            }
          },
          "ocultos": {
            "$ref": "#/components/schemas/Ocultos"
          },
          "mapa_vazio": {
            "type": "string",
            "enum": [
              "filtro_ativo",
              "zoom_insuficiente",
              "fonte_indisponivel",
              "fora_do_corredor",
              "nenhum_posto_conhecido"
            ],
            "nullable": true,
            "description": "Motivo do mapa vazio (RN03 do app). null quando há pino ou grupo."
          },
          "corredor_verificado": {
            "type": "boolean",
            "description": "A janela toca um corredor verificado pelo Curador. false: mostrar o aviso de área não verificada (RN05 do app)."
          },
          "fontes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SituacaoFonte"
            }
          }
        },
        "required": [
          "janela",
          "pinos",
          "grupos",
          "ocultos",
          "mapa_vazio",
          "corredor_verificado",
          "fontes"
        ]
      },
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "pedido_invalido"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "erro",
          "mensagem"
        ]
      },
      "AtributoTexto": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "string",
            "nullable": true,
            "description": "null = não informado."
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true
          }
        },
        "required": [
          "valor",
          "origem",
          "data"
        ]
      },
      "AtributoSituacao": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "string",
            "enum": [
              "operacional",
              "fora_de_operacao",
              "planejado",
              "fechado_definitivamente",
              "desconhecida"
            ],
            "nullable": true,
            "description": "null = não informado."
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true
          }
        },
        "required": [
          "valor",
          "origem",
          "data"
        ]
      },
      "Conector": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "CCS2",
              "CCS1",
              "TIPO_2",
              "TIPO_1",
              "CHADEMO",
              "GBT",
              "TESLA",
              "TOMADA",
              "OUTRO",
              "DESCONHECIDO"
            ]
          },
          "potencia_kw": {
            "type": "number",
            "nullable": true
          },
          "quantidade": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "tipo",
          "potencia_kw",
          "quantidade"
        ]
      },
      "AtributoConectores": {
        "type": "object",
        "properties": {
          "valor": {
            "nullable": true,
            "description": "null = não informado.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conector"
            }
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true
          }
        },
        "required": [
          "valor",
          "origem",
          "data"
        ]
      },
      "AtributoFuncionamento": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "string",
            "enum": [
              "funcionando",
              "parcial",
              "nao_funcionando",
              "desativado",
              "inexistente"
            ],
            "nullable": true,
            "description": "null = não informado."
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true
          }
        },
        "required": [
          "valor",
          "origem",
          "data"
        ]
      },
      "Carregador": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "CCS2",
              "CCS1",
              "TIPO_2",
              "TIPO_1",
              "CHADEMO",
              "GBT",
              "TESLA",
              "TOMADA",
              "OUTRO",
              "DESCONHECIDO"
            ]
          },
          "funcionou": {
            "type": "boolean",
            "nullable": true
          },
          "potencia_observada_kw": {
            "type": "number",
            "nullable": true,
            "description": "null quando não houve recarga (nunca zero)."
          }
        },
        "required": [
          "tipo",
          "funcionou",
          "potencia_observada_kw"
        ]
      },
      "AtributoCarregadores": {
        "type": "object",
        "properties": {
          "valor": {
            "nullable": true,
            "description": "Funcionamento e potência observados por carregador.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Carregador"
            }
          },
          "origem": {
            "type": "string",
            "enum": [
              "open_charge_map",
              "verificacao_propria",
              "google"
            ],
            "nullable": true
          },
          "data": {
            "type": "string",
            "format": "date",
            "example": "2026-11-12",
            "nullable": true
          }
        },
        "required": [
